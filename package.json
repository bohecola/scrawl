{
  "name": "scrawl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && node scripts/check-locales.mjs",
    "i18n:check": "node scripts/check-locales.mjs",
    "icons:build": "node --experimental-strip-types scripts/build-icon-themes.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lodash-es": "^4.18.1",
    "monaco-editor": "^0.56.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/codicon": "^1.2.71",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/material-icon-theme": "^1.2.70",
    "@iconify-json/vscode-icons": "^1.2.76",
    "@iconify/tailwind4": "^1.2.3",
    "@iconify/utils": "^3.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
